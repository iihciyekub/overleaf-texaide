{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Overleaf texAide",
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "version": "3.0.0",
  "description": "Overleaf TeX tools in a Chrome Side Panel",
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Overleaf texAide side panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.webofscience.com/*",
        "https://*.webofscience.com/*",
        "*://*.webofknowledge.com/*",
        "*://*.isiknowledge.com/*",
        "*://*.clarivate.cn/*",
        "*://*.clarivate.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "console-filter.js"
      ]
    },
    {
      "matches": [
        "https://*.overleaf.com/project/*",
        "https://www.overleaf.com/project/*",
        "https://cn.overleaf.com/project/*"
      ],
      "run_at": "document_idle",
      "js": [
        "overleaf-content.js"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle",
      "js": [
        "contentScript.js"
      ]
    },
    {
      "matches": [
        "https://www.webofscience.com/*",
        "https://*.webofscience.com/*",
        "*://*.webofknowledge.com/*",
        "*://*.isiknowledge.com/*",
        "*://*.clarivate.cn/*",
        "*://*.clarivate.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "z-Wos-loader.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "z-Wos.js",
        "jquery-3.7.0.js",
        "all.min.css",
        "all.min.js",
        "pub-fun.js",
        "z-easyscholar.js",
        "z-wos-doi-query.js",
        "z-chat.js",
        "prompts/wos-query.md",
        "injected.js",
        "module-bridge.js",
        "webfonts/*.woff2",
        "webfonts/*.ttf"
      ],
      "matches": [
        "https://www.webofscience.com/*",
        "https://*.webofscience.com/*",
        "*://*.webofknowledge.com/*",
        "*://*.isiknowledge.com/*",
        "*://*.clarivate.cn/*",
        "*://*.clarivate.com/*"
      ]
    },
    {
      "resources": [
        "chatgpt-prompts-quickload.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*"
      ]
    },
    {
      "resources": [
        "pub-fun.js",
        "z-doi-pdf-download.js",
        "z-cnki-pdf-download.js",
        "prompts/wos-query.md",
        "all.min.css",
        "all.min.js",
        "webfonts/*.woff2",
        "webfonts/*.ttf"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
