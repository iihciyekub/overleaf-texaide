{
  "name": "overleaf-texaide",
  "version": "3.0.0",
  "description": "Overleaf TeX tools and research workflow Side Panel extension",
  "private": true,
  "scripts": {
    "test": "node --test",
    "watch": "node ./node_modules/webpack/bin/webpack.js --mode=development --watch --config config/webpack.config.js",
