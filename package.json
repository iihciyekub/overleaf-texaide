    "size-plugin": "^2.0.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^4.10.0",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "@citation-js/core": "0.7.21",
    "@citation-js/plugin-csl": "0.7.22",
    "citeproc-locales": "1.0.2",
    "docx": "9.7.1",
    "jquery": "^4.0.0",
    "opencc-js": "^1.4.1"
